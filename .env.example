# Clave DEMO gratuita de CoinGecko (solo servidor; NUNCA con prefijo público).
# Consíguela gratis en https://www.coingecko.com/api → "Demo (Beta) API key".
# Sin ella el proxy funciona igual, pero con menos límite y SIN precio histórico
# por fecha. Con ella se desbloquea /coins/{id}/history y sube el límite.
COINGECKO_API_KEY=

# Clave GRATUITA de Alchemy para el lector de billeteras (solo servidor).
# Consíguela en https://dashboard.alchemy.com → crea una app → "API Key".
# Sin ella, las billeteras de Bitcoin funcionan igual; las de Ethereum y
# compatibles y las de Solana muestran un aviso hasta que se configure.
ALCHEMY_API_KEY=
