# Clave DEMO gratuita de CoinGecko (solo servidor; NUNCA con prefijo público).
# Consíguela gratis en https://www.coingecko.com/api → "Demo (Beta) API key".
# Sin ella el proxy funciona igual, pero con menos límite y SIN precio histórico
# por fecha. Con ella se desbloquea /coins/{id}/history y sube el límite.
COINGECKO_API_KEY=

# OPCIONAL. Clave gratuita de Alchemy para el lector de billeteras (servidor).
# Sin ella el lector funciona igual, sin cuenta, con los nodos públicos de cada
# red: en Ethereum y compatibles encuentra la moneda nativa y las ~500 monedas
# principales; en Solana y Bitcoin, todo. Con ella encuentra también tokens
# pequeños o nuevos. https://dashboard.alchemy.com → crea una app → "API Key".
ALCHEMY_API_KEY=
